## 跃云 AIOps+ 私有化业务配置（示例）
## 注意：不要把真实密钥提交到 Git 仓库

# 私有化开关（必须）
PRIVATE_DEPLOYMENT=true

# JWT/会话密钥（必改）
SECRET_KEY=change_me_secret_key

# License 公钥路径（容器内路径）
LICENSE_PUBLIC_KEY_PATH=/app/keys/license_public.pem

# （可选）固定机器码（强烈推荐，避免重启/网卡变动导致 machine_code_changed）
# AIOPS_MACHINE_CODE=YOUR_FIXED_MACHINE_CODE

# （可选）大模型配置（示例）
# AI_MODEL_PROVIDER=deepseek
# OPENAI_API_BASE=https://api.deepseek.com
# OPENAI_API_KEY=***
# MODEL_NAME=deepseek-chat

