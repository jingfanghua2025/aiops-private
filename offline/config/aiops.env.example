# 必填：MySQL root 密码（仅容器内部使用）
MYSQL_ROOT_PASSWORD=ChangeMe_123

# 业务密钥：JWT（建议部署时修改）
SECRET_KEY=change_me

# 试用期天数（默认 30）
LICENSE_TRIAL_DAYS=30

# license 公钥路径（公钥可随部署包一起分发）
LICENSE_PUBLIC_KEY_PATH=/app/keys/license_public.pem

# ====== 内网大模型（OpenAI兼容/DeepSeek等）======
AI_MODEL_PROVIDER=auto
OPENAI_API_BASE=http://intranet-llm.local/v1
OPENAI_API_KEY=change_me
MODEL_NAME=deepseek-chat

# ====== 可选：DashScope ======
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=change_me
# DASHSCOPE_MODEL_NAME=qwen-turbo

# 私有化部署模式：关闭注册/找回/微信/支付/运营看板，仅管理员创建用户
PRIVATE_DEPLOYMENT=true
